PROJECT_NAME=ZambeCare
ENVIRONMENT=development

POSTGRES_DB=zambecare
POSTGRES_USER=zambecare_app
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_PORT=5432

ORACLE_PASSWORD=replace-with-a-long-oracle-password
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_DBT_USER=zc_dbt
ORACLE_DBT_PASSWORD=replace-with-a-long-dbt-password

# Phase 3 Oracle Autonomous Database (mTLS)
ORACLE_INGEST_USER=ZC_INGEST
ORACLE_INGEST_PASSWORD=replace-with-a-distinct-ingestion-password
ORACLE_DSN=dataprd_low
ORACLE_WALLET_DIR=/opt/oracle/wallet
ORACLE_WALLET_PASSWORD=replace-with-the-private-wallet-password
INGEST_POSTGRES_URL=postgresql://zambecare_app:replace-with-a-long-local-password@postgres:5432/zambecare
CODE_VERSION=phase3-local
AIRFLOW_PORT=8080

API_PORT=8000
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SECRET_KEY=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000/api/v1
